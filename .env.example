# Which deployment to use: 31337 (local Anvil) or 46630 (Robinhood Chain testnet)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# Foundry reads these for `forge script --rpc-url rh_testnet`
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com

# Deployer / admin / demo market operator (owns the demo feeds and venue)
DEPLOYER_PK=
# Broker simulator signer (must match BROKER_ADDRESS used at deploy time)
BROKER_PK=
BROKER_ADDRESS=
# Name shown on the broker's sign-in and consent pages, and where they may send the user back to (the app)
BROKER_NAME=Harbor Securities
BROKER_REDIRECT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keeper (any funded key; earns the keeper tip)
KEEPER_PK=

# Deploy options
USE_MOCKS=true

# Services
BROKER_PORT=8787
MARKET_PORT=8788
# Demo control plane (localhost only). Every service reads ADMIN_TOKEN to guard its /admin routes;
# the default works locally, set your own anywhere the services are reachable by others.
CONTROL_PORT=8791
ADMIN_TOKEN=
ATTEST_INTERVAL_MS=30000
ATTEST_TTL_S=300
KEEPER_POLL_MS=2000
MARKET_TICK_MS=30000

# Agent service. AGENT_PK is the treasury: it pays gas for the per-facility agent keys and never trades.
# Agent keys are derived from AGENT_SEED (defaults to AGENT_PK) + agent id + facility address.
AGENT_PK=
AGENT_SEED=
AGENT_PORT=8789
AGENT_INTERVAL_MS=60000
AGENT_GAS_MIN_ETH=0.002
AGENT_GAS_TOPUP_ETH=0.01

# Weekend-gap simulator (broker-only margin vs Hapax). Pure computation, no chain access.
SIM_PORT=8790
# Enables the Claude Discretionary agent in the catalog; without it only the rules agents are offered
ANTHROPIC_API_KEY=

# Web app (Vite reads VITE_* from this file). Users connect a browser wallet; the app never holds keys.
VITE_CHAIN_ID=31337
VITE_RPC_URL=
VITE_BROKER_URL=http://localhost:8787
VITE_AGENT_URL=http://localhost:8789
